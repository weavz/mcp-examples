# Use a custom MCP endpoint returned by your Weavz setup. The hosted personal
# /mcp/weavz endpoint uses OAuth and is not an arbitrary bearer-token endpoint.
WEAVZ_MCP_URL=
WEAVZ_MCP_TOKEN=
WEAVZ_MCP_MODE=tools

# Optional model run only. Set a model string supported by PydanticAI and the
# provider's credential using its normal environment variable.
WEAVZ_MODEL=
# OPENAI_API_KEY=
